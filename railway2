def identify(dist):
    """Runs AFTER the train has stopped: the camera looks at the obstacle and names it."""
    votes, lastfr = {}, None
    for _ in range(IDENT_FRAMES):
        fr = camera.get_frame()
        if fr is None:
            time.sleep(0.2)
            continue
        lastfr = fr
        try:
            r = detector.detect(fr)
        except Exception as e:
            print("[Identify] error: %s" % e)
            continue
        if r["found"]:
            v = votes.setdefault(r["label"], {"n": 0, "conf": 0.0, "src": r["source"], "box": r["box"]})
            v["n"] += 1
            if r["conf"] >= v["conf"]:
                v.update(conf=r["conf"], src=r["source"], box=r["box"])
        time.sleep(0.1)
    dtxt = "%.1f cm" % dist if dist is not None else ""
    if votes:
        label = max(votes, key=lambda k: (votes[k]["n"], votes[k]["conf"]))
        v = votes[label]
        OBS.update(label=label, conf=v["conf"])
        set_snapshot(lastfr, "%s %s" % (label, dtxt), v["box"])
    else:
        OBS.update(label=None, conf=0.0)
        set_snapshot(lastfr, "Unknown object %s" % dtxt)
    OBS["state"] = "stopped"


def monitor():
    """LiDAR (or ultrasonic if enabled) <= STOP_CM -> motor off at once -> camera names the object."""
    hits, clear_t, lost_t = 0, None, None
    while True:
        time.sleep(0.05)
        now = time.time()
        lv = sval(LD)
        uv = sval(US) if USE_ULTRASONIC else None
        vals = [v for v in (lv, uv) if v is not None]
        near = min(vals) if vals else None
        OBS["nearest"] = near
        hit = near is not None and near <= STOP_CM

        if OBS["state"] == "clear":
            # safety: LiDAR blind while the train is moving
            if STOP_ON_LIDAR_LOSS and train.running and lv is None:
                lost_t = lost_t or now
                if now - lost_t > LIDAR_LOSS_SECONDS:
                    train.stop("LiDAR has no valid reading - stopped for safety", braked=True)
                    lost_t = None
            else:
                lost_t = None
            hits = hits + 1 if hit else 0
            if hits >= 2:
                src = []
                if lv is not None and lv <= STOP_CM:
                    src.append("LiDAR")
                if uv is not None and uv <= STOP_CM:
                    src.append("Ultrasonic")
                train.stop("Obstacle at %.1f cm (%s)" % (near, " + ".join(src)), braked=True)   # 1) MOTOR OFF FIRST
                OBS.update(state="identifying", t0=now, label=None, conf=0.0, distance=near, source=" + ".join(src))
                threading.Thread(target=identify, args=(near,), daemon=True).start()           # 2) THEN name it
                clear_t, hits = None, 0
        else:
            if near is not None:
                OBS["distance"] = near
            # clear only when a REAL reading says it is far (no reading = still blocked)
            if near is not None and near > STOP_CM + CLEAR_MARGIN_CM:
                if clear_t is None:
                    clear_t = now
                elif now - clear_t > 1.0 and OBS["state"] == "stopped":
                    OBS.update(state="clear", label=None, source=None, conf=0.0)
                    hits = 0
            else:
                clear_t = None


# ------------------------------ train / motor -------------------------------
class Train:
    def __init__(self):
        self.running, self.braked, self.reason = False, False, ""
        self.target, self.cur, self.t_start = DEFAULT_SPEED, 0, 0.0
        self.fwd, self.low, self.pwm = [], [], None
        if GPIO_OK and ON_PI:
            try:
                self.fwd = [DigitalOutputDevice(p) for p in MOTOR_FWD_PINS]
                self.low = [DigitalOutputDevice(p) for p in MOTOR_LOW_PINS]
                self.pwm = PWMOutputDevice(MOTOR_PWM_PIN, frequency=1000)
            except Exception as e:
                print("[Motor] cannot start: %s (motor simulated)" % e)
        threading.Thread(target=self.loop, daemon=True).start()

    def _apply(self, v):
        if not self.pwm:
            return
        for d in self.low:
            d.off()
        if v <= 0:
            for d in self.fwd:
                d.off()
            self.pwm.value = 0
        else:
            for d in self.fwd:
                d.on()
            self.pwm.value = min(1.0, v / float(SPEED_MAX))

    def start(self):
        if OBS["state"] != "clear":
            return False, "Obstacle ahead - clear the track first"
        near = OBS["nearest"]
        if near is not None and near <= STOP_CM:
            return False, "Obstacle within %g cm - clear the track first" % STOP_CM
        if STOP_ON_LIDAR_LOSS and sval(LD) is None:
            return False, "LiDAR has no valid reading - check the sensor (object closer than 20 cm, or wiring)"
        self.braked, self.reason, self.running, self.t_start = False, "", True, time.time()
        self.cur = min(START_PWM, self.target)
        return True, "started"

    def stop(self, reason="Stopped", braked=False):
        self.running, self.cur, self.braked, self.reason = False, 0, braked, reason
        self._apply(0)

    def ramping(self):
        return self.running and (time.time() - self.t_start < RAMP_SECONDS or self.cur != self.target)

    def loop(self):
        while True:
            if self.running:
                frac = min(1.0, (time.time() - self.t_start) / RAMP_SECONDS)
                want = self.target if self.target <= START_PWM else START_PWM + (self.target - START_PWM) * frac
                self.cur = int(round(self.cur + max(-6, min(6, want - self.cur))))
                self._apply(self.cur)
            time.sleep(0.05)


