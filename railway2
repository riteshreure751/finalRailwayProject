.code textarea{color:transparent;caret-color:#fff}
.k{color:#ff6b7a}.s{color:#9be37a}.c{color:#6f8fc0;font-style:italic}.n{color:#ffb86b}.f{color:#6bc1ff}
.out{height:104px;margin:0;background:#080f1c;border:1px solid var(--line);border-radius:5px;padding:7px 10px;overflow:auto;font:13px/18px "DejaVu Sans Mono",Consolas,monospace;white-space:pre-wrap;word-break:break-all;color:#cfe0ff}
.term{height:250px}
.irow{display:flex;gap:6px;align-items:center}
.irow input{flex:1;background:#080f1c;border:1px solid var(--line);border-radius:5px;padding:8px 10px;font:14px "DejaVu Sans Mono",Consolas,monospace;outline:0;min-width:0}
