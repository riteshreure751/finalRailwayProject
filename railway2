.toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);background:#16305c;border:1px solid #2f66c2;padding:11px 20px;border-radius:8px;opacity:0;pointer-events:none;transition:opacity .25s;z-index:30}
