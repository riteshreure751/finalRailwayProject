<div class="toast" id="toast"></div>
<div class="modal" id="modal"><div class="box"><h2 style="justify-content:center">Shut down the Raspberry Pi?</h2><p>The train will stop and the dashboard will go offline. Enter the password to confirm.</p>
 <input type="password" id="shPass" inputmode="numeric" placeholder="Password" autocomplete="off">
 <div class="err" id="shErr"></div>
 <div class="row"><button class="btn" id="mNo">Cancel</button><button class="btn red" id="mYes">Shut down</button></div></div></div>

<script>
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
const J=(url,body)=>fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body||{})}).then(r=>r.json().catch(()=>({})));
function toast(t){const e=$('#toast');e.textContent=t;e.classList.add('on');clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove('on'),2600)}

/* ---------- realtime stream ---------- */
let lastT=null, snapId=-1, sliderBusy=false, firstSync=true;
function setSensor(id,d){$('#'+id+'Note').textContent=d.note||'';const b=$('#'+id+'Badge');$('#'+id+'Val').textContent=d.ok?d.cm.toFixed(1):'--';b.className='badge'+(d.ok?'':' off');b.querySelector('b').textContent=d.ok?(d.sim?'Sim':'Live'):'No data'}
function render(d){
  lastT=d.train;
  $('#piName').textContent=d.sim?'Simulation mode':'Raspberry Pi 4';
  setSensor('lidar',d.lidar);setSensor('ultra',d.ultra);
  $('#modelMsg').textContent='Camera AI - '+d.model.text;
  const o=d.obstacle,box=$('#alert'),cls={clear:'clear',identifying:'warn',stopped:'danger'}[o.state];
  box.className='card alert '+cls;
  $('#aTitle').textContent={clear:'TRACK CLEAR \u2014 NO OBSTACLE',identifying:'OBSTACLE FOUND \u2014 TRAIN STOPPED, IDENTIFYING...',stopped:'OBSTACLE \u2014 TRAIN STOPPED'}[o.state];
  $('#aObj').textContent=o.state==='clear'?'None':(o.state==='identifying'?'Identifying...':(o.label?o.label+(o.conf?' ('+Math.round(o.conf*100)+'%)':''):'Unknown object'));
  $('#aDist').textContent=(o.distance==null?'--':o.distance.toFixed(1))+' cm';
  $('#aNote').textContent=o.state==='clear'?'Stops at '+d.cfg.stop_cm+' cm (LiDAR'+(d.cfg.use_ultra?' + ultrasonic':'')+') \u00b7 camera: '+d.pi.camera+(d.pi.temp?' \u00b7 CPU '+d.pi.temp+'\u00b0C':''):('Stopped by: '+(o.source||'?')+(o.state==='stopped'&&!o.label?' \u00b7 camera could not name it (add more dataset images / install YOLO)':''));
  if(o.snap_id!==snapId&&o.snap_id>0){snapId=o.snap_id;$('#aImg').src='/obstacle.jpg?'+snapId}
  const t=d.train;
  $('#curSpeed').textContent=t.cur+' / '+d.cfg.speed_max;
  if(!sliderBusy&&(firstSync||!document.activeElement||document.activeElement.id!=='speed')){$('#speed').value=t.target;firstSync=false}
  $('#tgt').textContent=t.target;
  const b=$('#trainBtn');
  if(t.running){b.className='tbtn '+(t.ramping?'ramp':'');b.innerHTML=t.ramping?'&#9654; Accelerating (tap to stop)':'&#9654; Running \u2014 constant speed (tap to stop)'}
  else if(t.braked){b.className='tbtn brk';b.innerHTML='&#9632; '+esc(t.reason||'Stopped')+' (tap to restart)'}
  else{b.className='tbtn idle';b.innerHTML='&#9654; Start Train'}
  if(t.reason&&!t.running)$('#trainMsg').textContent=t.reason;
}
function connect(){
  const es=new EventSource('/stream'),c=$('#conn');
  es.onopen=()=>{c.className='conn';$('#connTxt').textContent='Connected'};
  es.onerror=()=>{c.className='conn off';$('#connTxt').textContent='Disconnected'};
  es.onmessage=e=>render(JSON.parse(e.data));
}
connect();
$('#video').onerror=function(){setTimeout(()=>{this.src='/video_feed?'+Date.now()},2000)};

/* ---------- train ---------- */
$('#trainBtn').onclick=async()=>{
  if(lastT&&lastT.running){await J('/api/train/stop');return}
  const r=await J('/api/train/start',{speed:+$('#speed').value});
  $('#trainMsg').textContent=r.ok?'Starting, then speeding up to the target...':(r.msg||'Could not start');
};
$('#speed').oninput=()=>{sliderBusy=true;clearTimeout($('#speed').t);$('#speed').t=setTimeout(async()=>{await J('/api/train/speed',{speed:+$('#speed').value});sliderBusy=false},120)};

/* ---------- camera dataset ---------- */
async function loadDatasets(sel){
  const l=await (await fetch('/api/datasets')).json(),s=$('#saveTo'),keep=sel||s.value;
  s.innerHTML=l.map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('')+'<option value="__new__">+ New folder...</option>';
  if(l.includes(keep))s.value=keep;
}
$('#saveTo').onchange=async()=>{
  if($('#saveTo').value!=='__new__')return;
  const n=(prompt('New dataset folder name (this becomes the object label, e.g. cow, buffalo, giraffe):')||'').trim().replace(/[^A-Za-z0-9_-]/g,'_');
  if(n){await J('/api/create',{path:'dataset/'+n,type:'dir'});await loadDatasets(n);loadTree()}else loadDatasets();
};
$('#capBtn').onclick=async()=>{
  const f=$('#saveTo').value;if(!f||f==='__new__'){toast('Choose a folder first');return}
  $('#capMsg').textContent='Saving and analysing...';
  const r=await J('/api/capture',{folder:f});
  $('#capMsg').textContent=r.ok?'Saved '+r.file.split('/').pop()+' ('+r.count+' images in '+f+') \u00b7 camera sees: '+r.sees:(r.error||'Failed');
  if(r.ok){toast('Saved to dataset/'+f);loadTree()}
};
$('#trainModelBtn').onclick=async()=>{const r=await J('/api/model/train');toast(r.ok?'Training started - watch the status line':(r.error||'Failed'))};

/* ---------- file tree ---------- */
const FOLDER='<svg width="22" height="22" viewBox="0 0 24 24" fill="#f6b73c"><path d="M2 5a2 2 0 0 1 2-2h5l2 2h9a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z"/></svg>';
const FILE='<svg width="20" height="20" viewBox="0 0 24 24" fill="#8fb4ff"><path d="M6 2h8l6 6v14H6zM14 3v6h6"/></svg>';
const open=new Set(['dataset']);let selDir='code';
function build(nodes){
  const ul=document.createElement('ul');
  nodes.forEach(n=>{
    const li=document.createElement('li'),row=document.createElement('div');row.className='trow';
    if(n.type==='dir'){
      const o=open.has(n.path);row.className+=n.path===selDir?' sel':'';
      row.innerHTML=`<span class="car">${o?'\u25BE':'\u25B8'}</span>${FOLDER}<span>${esc(n.name)}/</span>`;
      row.onclick=()=>{selDir=n.path;o?open.delete(n.path):open.add(n.path);loadTree()};
      li.appendChild(row);if(o)li.appendChild(build(n.children));
    }else if(n.type==='file'){
      row.innerHTML=`<span class="car"></span>${FILE}<span>${esc(n.name)}</span>`;
      row.onclick=()=>/\.(jpe?g|png|gif|bmp|webp)$/i.test(n.name)?window.open('/api/raw?path='+encodeURIComponent(n.path)):openFile(n.path);
      li.appendChild(row);
    }else{row.className+=' more';row.textContent=n.name;li.appendChild(row)}
    ul.appendChild(li);
  });return ul;
}
async function loadTree(){
  try{const j=await (await fetch('/api/tree')).json(),t=$('#tree'),sc=t.scrollTop;t.innerHTML='';t.appendChild(build(j.children));t.scrollTop=sc}catch(e){}
}
$('#refresh').onclick=loadTree;
$('#newFile').onclick=async()=>{const n=prompt('New file name (inside '+selDir+'/):','new_script.py');if(!n)return;const p=selDir+'/'+n;const r=await J('/api/create',{path:p,type:'file'});r.error?toast(r.error):(await loadTree(),openFile(p))};
$('#newDir').onclick=async()=>{const n=prompt('New folder name (inside '+selDir+'/):');if(!n)return;const r=await J('/api/create',{path:selDir+'/'+n,type:'dir'});r.error?toast(r.error):(open.add(selDir),loadTree(),loadDatasets())};

/* ---------- editor ---------- */
let cur=null;const ta=$('#ta'),hl=$('#hl'),gut=$('#gut');
function highlight(src){
  const re=/(#.*$)|("{3}[\s\S]*?"{3}|'{3}[\s\S]*?'{3}|"(?:\\.|[^"\\\n])*"|'(?:\\.|[^'\\\n])*')|\b(def|class|if|elif|else|while|for|in|return|import|from|as|try|except|finally|with|pass|break|continue|and|or|not|is|lambda|global|raise|yield|True|False|None)\b|\b(\d+\.?\d*)\b|\b([A-Za-z_]\w*)(?=\()/gm;
  let out='',last=0,m;
  while((m=re.exec(src))){
    out+=esc(src.slice(last,m.index));
    const c=m[1]?'c':m[2]?'s':m[3]?'k':m[4]?'n':'f';
    out+=`<span class="${c}">${esc(m[0])}</span>`;last=re.lastIndex;
    if(m[0].length===0)re.lastIndex++;
  }
  return out+esc(src.slice(last))+'\n';
}
function upd(){hl.innerHTML=highlight(ta.value);const n=ta.value.split('\n').length;gut.textContent=Array.from({length:n},(_,i)=>i+1).join('\n');sync()}
function sync(){hl.scrollTop=ta.scrollTop;hl.scrollLeft=ta.scrollLeft;gut.scrollTop=ta.scrollTop}
ta.addEventListener('input',upd);ta.addEventListener('scroll',sync);
ta.addEventListener('keydown',e=>{
  if(e.key==='Tab'){e.preventDefault();const s=ta.selectionStart;ta.setRangeText('    ',s,ta.selectionEnd,'end');upd()}
  if((e.ctrlKey||e.metaKey)&&e.key==='s'){e.preventDefault();save()}
  if(e.key==='F5'){e.preventDefault();run(false)}
});
async function openFile(p){
  const r=await (await fetch('/api/file?path='+encodeURIComponent(p))).json();
  if(r.error){toast(r.error);return}
  ta.value=r.content;cur=p;$('#fname').textContent=p;upd();tab('editor');
}
async function save(){if(!cur){toast('Open or create a file first');return false}const r=await J('/api/file',{path:cur,content:ta.value});toast(r.ok?'Saved '+cur:(r.error||'Save failed'));return !!r.ok}
async function run(dbg){if(!(await save()))return;const r=await J('/api/run',{path:cur,debug:dbg});if(r.error)toast(r.error)}
$('#bSave').onclick=save;$('#bRun').onclick=()=>run(false);$('#bDbg').onclick=()=>run(true);$('#bStop').onclick=()=>J('/api/run/stop');
$('#shellIn').onkeydown=e=>{if(e.key==='Enter'){const v=e.target.value;e.target.value='';$('#shell').textContent+='> '+v+'\n';J('/api/run/input',{text:v})}};
upd();

/* ---------- tabs / terminal ---------- */
let curTab='editor';
function tab(n){['editor','terminal'].forEach(x=>{$('#tab-'+x).classList.toggle('on',x===n);$('#pane-'+x).style.display=x===n?'flex':'none'});curTab=n;if(n==='terminal')setTimeout(()=>$('#termIn').focus(),50)}
$('#tab-editor').onclick=()=>tab('editor');$('#tab-terminal').onclick=()=>tab('terminal');
const st={run:{pos:0},term:{pos:0}};
async function pollBuf(url,s,el){
  try{const j=await (await fetch(url+'?since='+s.pos)).json();
    if(j.text){const stick=el.scrollTop+el.clientHeight>=el.scrollHeight-30;el.textContent+=j.text;if(el.textContent.length>120000)el.textContent=el.textContent.slice(-80000);if(stick)el.scrollTop=el.scrollHeight}
    s.pos=j.next;return j}catch(e){}
}
setInterval(async()=>{const j=await pollBuf('/api/run/output',st.run,$('#shell'));if(j){$('#bStop').disabled=!j.running}},500);
setInterval(()=>{if(curTab==='terminal')pollBuf('/api/term/output',st.term,$('#termOut'))},350);
const hist=[];let hi=0;
$('#termIn').onkeydown=e=>{
  if(e.key==='Enter'){const v=e.target.value;if(v)hist.push(v);hi=hist.length;e.target.value='';J('/api/term/input',{data:v+'\n'})}
  else if(e.key==='ArrowUp'){if(hi>0)e.target.value=hist[--hi]||'';e.preventDefault()}
  else if(e.key==='ArrowDown'){e.target.value=hist[++hi]||'';e.preventDefault()}
  else if(e.ctrlKey&&e.key==='c'&&!window.getSelection().toString()){J('/api/term/input',{data:'\x03'});e.preventDefault()}
};
$('#tInt').onclick=()=>J('/api/term/input',{data:'\x03'});
$('#tClr').onclick=()=>{$('#termOut').textContent=''};

/* ---------- sidebar ---------- */
$$('#nav a').forEach(a=>a.onclick=()=>{
  $$('#nav a').forEach(x=>x.classList.remove('on'));a.classList.add('on');
  if(a.dataset.tab)tab(a.dataset.tab);
  const t=$('#'+a.dataset.go);t.scrollIntoView({behavior:'smooth',block:'start'});
  if(a.dataset.go!=='top'){t.classList.add('flash');setTimeout(()=>t.classList.remove('flash'),900)}
});

/* ---------- shutdown (password protected) ---------- */
function openShut(){$('#shPass').value='';$('#shErr').textContent='';$('#modal').classList.add('on');setTimeout(()=>$('#shPass').focus(),50)}
async function doShut(){
  const yes=$('#mYes');yes.disabled=true;yes.textContent='Shutting down...';
  const r=await J('/api/shutdown',{password:$('#shPass').value});
  yes.disabled=false;yes.textContent='Shut down';
  if(r.ok){
    document.body.innerHTML='<div style="display:flex;height:100vh;align-items:center;justify-content:center;flex-direction:column;background:#0a101c;color:#e9efff;font-family:sans-serif;text-align:center;padding:20px"><h1>Raspberry Pi is shutting down</h1><p style="color:#9db0d3;font-size:18px">Wait about 15-20 seconds until the green LED stops blinking and stays off.<br>Then switch off the battery.</p></div>';
  }else{$('#shErr').textContent=r.error||'Shutdown failed';$('#shPass').select()}
}
$('#btnShut').onclick=openShut;
$('#mNo').onclick=()=>$('#modal').classList.remove('on');
$('#mYes').onclick=doShut;
$('#shPass').onkeydown=e=>{if(e.key==='Enter')doShut();if(e.key==='Escape')$('#modal').classList.remove('on')};

/* ---------- obstacle check (camera only) ---------- */
function showCheck(r){
  $('#chkR').className='chkR '+r.level;$('#chkV').textContent=r.verdict;
  $('#chkG').innerHTML=`<div>Object<b style="font-size:22px">${esc(r.label||'None')}</b></div><div>Confidence<b>${r.conf?Math.round(r.conf*100)+'%':'--'}</b></div><div>Source<b style="font-size:22px">${esc(r.source||'--')}</b></div><div>Camera<b style="font-size:20px">${esc(r.camera)}</b></div>`;
  if(r.snap_id){$('#chkT').style.display='block';$('#chkImg').src='/check.jpg?'+r.snap_id}
}
async function loadChkHist(){try{const h=await (await fetch('/api/check')).json();$('#chkH').innerHTML=h.slice().reverse().map(x=>`<div>${esc(x.time)} \u2014 ${esc(x.verdict)}</div>`).join('')}catch(e){}}
$('#chkBtn').onclick=async()=>{
  const b=$('#chkBtn');b.disabled=true;b.textContent='Checking...';$('#chkV').textContent='Analysing camera image...';
  try{showCheck(await J('/api/check'));loadChkHist()}catch(e){toast('Check failed')}
  b.disabled=false;b.textContent='Run Obstacle Check';
};

loadDatasets();loadTree();loadChkHist();setInterval(loadTree,6000);
</script></body></html>
"""

if __name__ == "__main__":
    start_sensors()
    threading.Thread(target=monitor, daemon=True).start()
    print("Project folder :", ROOT)
    print("Dashboard      : http://<raspberry-pi-ip>:%d   (login %s)" % (PORT, AUTH_USER if AUTH_PASS else "disabled"))
    app.run(host=HOST, port=PORT, threaded=True, debug=False)
