def pretty(name):
    return name.replace("_", " ").replace("-", " ").strip().title()


def is_clear_name(name):
    return "clear" in name.lower()


def make_hog():
    return cv2.HOGDescriptor((128, 96), (16, 16), (8, 8), (8, 8), 9)


class Detector:
    """
    Camera brain. Two parts work together:
      1) YOLOv4-tiny (if its files are in models/)  -> names animals/people/objects (cow, giraffe, ...)
      2) Dataset classifier (trained from dataset/)  -> learns YOUR objects and YOUR clear track
    """
    def __init__(self):
        self.lock = threading.RLock()
        self.yolo, self.yolo_out = None, None
        self.feats, self.labels, self.names, self.counts = None, None, [], {}
        self.hog = make_hog()
        self.training, self.msg = False, ""
        self.npz = os.path.join(ROOT, "models", "classifier.npz")
        cfg = os.path.join(ROOT, "models", "yolov4-tiny.cfg")
        wts = os.path.join(ROOT, "models", "yolov4-tiny.weights")
        if os.path.exists(cfg) and os.path.exists(wts):
            try:
                self.yolo = cv2.dnn.readNetFromDarknet(cfg, wts)
                self.yolo.setPreferableBackend(cv2.dnn.DNN_BACKEND_OPENCV)
                self.yolo.setPreferableTarget(cv2.dnn.DNN_TARGET_CPU)
                self.yolo_out = self.yolo.getUnconnectedOutLayersNames()
                print("[Detector] YOLOv4-tiny loaded")
            except Exception as e:
                self.yolo = None
                print("[Detector] YOLO load failed: %s" % e)
        else:
            print("[Detector] YOLO files not found in models/ (dataset classifier only)")
        self.load()

    # ---- dataset classifier ----
    def feat(self, f, hog):
        img = cv2.resize(f, (128, 96))
        h = hog.compute(cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)).flatten().astype(np.float32)
        hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)
        c = cv2.calcHist([hsv], [0, 1, 2], None, [8, 4, 4], [0, 180, 0, 256, 0, 256]).flatten().astype(np.float32)
        h /= (np.linalg.norm(h) + 1e-6)
        c /= (np.linalg.norm(c) + 1e-6)
        v = np.concatenate([h, c])
        return v / (np.linalg.norm(v) + 1e-6)

    def load(self):
        if not os.path.exists(self.npz):
            return
        try:
            z = np.load(self.npz, allow_pickle=False)
            names = [str(x) for x in z["names"]]
            counts = json.loads(str(z["counts"]))
            with self.lock:
                self.feats, self.labels, self.names, self.counts = z["feats"], z["labels"], names, counts
            print("[Detector] dataset model loaded: %s" % counts)
        except Exception as e:
            print("[Detector] dataset model load failed: %s" % e)

    def train(self):
        if self.training:
            return
        self.training, self.msg = True, "Training: reading images..."
        try:
            base = os.path.join(ROOT, "dataset")
            hog = make_hog()
            X, y, names, counts = [], [], [], {}
            for name in sorted(os.listdir(base)):
                d = os.path.join(base, name)
                if not os.path.isdir(d):
                    continue
                files = [x for x in sorted(os.listdir(d)) if x.lower().endswith((".jpg", ".jpeg", ".png"))]
                n = 0
                idx = len(names)
                for fn in files:
                    img = cv2.imread(os.path.join(d, fn))
                    if img is None:
                        continue
                    X.append(self.feat(img, hog)); y.append(idx)
                    X.append(self.feat(cv2.flip(img, 1), hog)); y.append(idx)
                    n += 1
                    self.msg = "Training: %s (%d images)..." % (name, n)
                if n:
                    names.append(name)
                    counts[name] = n
            if not any(is_clear_name(n) for n in names):
                self.msg = "Cannot train: put images in a folder whose name contains 'clear' (e.g. clear_no_obstacle)"
                return
            if not any(not is_clear_name(n) for n in names):
                self.msg = "Cannot train: add at least one obstacle folder with images (e.g. obstacle, cow)"
                return
            X, y = np.array(X, np.float32), np.array(y, np.int32)
            np.savez(self.npz, feats=X, labels=y, names=np.array(names), counts=np.array(json.dumps(counts)))
            with self.lock:
                self.feats, self.labels, self.names, self.counts = X, y, names, counts
            self.msg = "Training finished: " + ", ".join("%s %d" % (k, v) for k, v in counts.items())
            print("[Detector] " + self.msg)
        except Exception as e:
            self.msg = "Training failed: %s" % e
            print("[Detector] " + self.msg)
        finally:
            self.training = False

    def classify(self, f):
        v = self.feat(f, self.hog)
        sims = self.feats @ v
        k = min(7, len(sims))
        top = np.argsort(-sims)[:k]
        votes = {}
        for i in top:
            lab = int(self.labels[i])
            votes[lab] = votes.get(lab, 0.0) + float(max(sims[i], 0.0)) ** 6
        best = max(votes, key=votes.get)
        return self.names[best], votes[best] / (sum(votes.values()) + 1e-9)

    # ---- YOLO ----
    def run_yolo(self, f):
        h, w = f.shape[:2]
        blob = cv2.dnn.blobFromImage(f, 1 / 255.0, (YOLO_SIZE, YOLO_SIZE), swapRB=True, crop=False)
        self.yolo.setInput(blob)
        outs = self.yolo.forward(self.yolo_out)
        boxes, confs, ids = [], [], []
        for o in outs:
            for row in o:
                sc = row[5:]
                cid = int(np.argmax(sc))
                cf = float(row[4] * sc[cid])
                if cf < YOLO_CONF or cid >= len(COCO):
                    continue
                bw, bh = row[2] * w, row[3] * h
                boxes.append([int(row[0] * w - bw / 2), int(row[1] * h - bh / 2), int(bw), int(bh)])
                confs.append(cf)
                ids.append(cid)
        best = None
        if boxes:
            keep = cv2.dnn.NMSBoxes(boxes, confs, YOLO_CONF, 0.45)
            for i in np.array(keep).flatten():
                name = COCO[ids[i]]
                if name in IGNORE_YOLO:
                    continue
                x, y, bw, bh = boxes[i]
                cx, bottom = (x + bw / 2) / w, (y + bh) / h
                if 0.1 < cx < 0.9 and bottom > 0.35 and bw * bh > 0.01 * w * h:
                    score = confs[i] * bw * bh
                    if best is None or score > best[0]:
                        best = (score, pretty(name), confs[i], (max(x, 0) / w, max(y, 0) / h, min(x + bw, w) / w, min(y + bh, h) / h))
        return best[1:] if best else None

    def ready(self):
        return self.yolo is not None or self.feats is not None

    def detect(self, f):
        """Returns dict(found, label, conf, source, box, ready)."""
        with self.lock:
            res = {"found": False, "label": None, "conf": 0.0, "source": None, "box": None, "ready": self.ready()}
            cname, cconf = (None, 0.0)
            if self.feats is not None:
                cname, cconf = self.classify(f)
            yb = self.run_yolo(f) if self.yolo is not None else None
            if cname is not None and not is_clear_name(cname) and cconf >= CLS_CONF:
                label, src = pretty(cname), "Dataset"
                if label.lower() == "obstacle" and yb:      # generic folder -> use YOLO's specific name
                    label, src = yb[0], "YOLO"
                res.update(found=True, label=label, conf=round(cconf, 2), source=src, box=yb[2] if yb and src == "YOLO" else None)
            elif yb:
                res.update(found=True, label=yb[0], conf=round(yb[1], 2), source="YOLO", box=yb[2])
            return res

    def info(self):
        parts = ["YOLO: " + ("ready" if self.yolo is not None else "not installed")]
        parts.append("Dataset model: " + (", ".join("%s %d" % (k, v) for k, v in self.counts.items()) if self.feats is not None else "not trained yet"))
        txt = " | ".join(parts)
        if self.msg:
            txt += " | " + self.msg
        return {"yolo": self.yolo is not None, "classifier": self.feats is not None, "training": self.training,
                "classes": self.names, "text": txt}


