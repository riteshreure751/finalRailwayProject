def sval(d, maxage=0.6):
    return d["cm"] if (d["cm"] is not None and time.time() - d["t"] < maxage) else None


def parse_frames(buf):
    """Pull valid 9-byte TF-Luna frames out of buf (a bytearray, edited in place)."""
    out = []
    while len(buf) >= 9:
        if buf[0] == 0x59 and buf[1] == 0x59 and (sum(buf[:8]) & 0xFF) == buf[8]:
            out.append((buf[2] | (buf[3] << 8), buf[4] | (buf[5] << 8), (buf[6] | (buf[7] << 8)) / 8.0 - 256))
            del buf[:9]
        else:
            del buf[0]
    return out


def open_lidar():
    """Try the usual serial ports and baud rates until real TF-Luna frames show up."""
    ports = []
    for p in (LIDAR_PORT, "/dev/serial0", "/dev/ttyAMA0", "/dev/ttyS0"):
        if os.path.exists(p) and os.path.realpath(p) not in [os.path.realpath(x) for x in ports]:
            ports.append(p)
    if not ports:
        LDIAG["msg"] = "No serial port. Run sudo raspi-config > Interface Options > Serial Port (login shell: No, hardware: Yes) and reboot"
        return None
    most, err = 0, None
    for port in ports:
        for baud in dict.fromkeys([LIDAR_BAUD, 115200, 9600, 57600, 38400, 19200]):
            LDIAG["msg"] = "Scanning %s @ %d baud..." % (port, baud)
            try:
                ser = serial.Serial(port, baud, timeout=0.1)
            except Exception as e:
                err = "Cannot open %s: %s" % (port, e)
                break
            ser.reset_input_buffer()
            buf, n, t0 = bytearray(), 0, time.time()
            while time.time() - t0 < 0.6:
                d = ser.read(64)
                n += len(d)
                buf += d
            if parse_frames(buf):
                LDIAG.update(port=port, baud=baud, msg="TF-Luna found")
                return ser
            ser.close()
            most = max(most, n)
    if most == 0:
        LDIAG["msg"] = err or "Serial opens but 0 bytes received: check TF-Luna TX -> Pin 10, RX -> Pin 8, 5V power, and that serial login shell is disabled"
    else:
        LDIAG["msg"] = "Bytes received but no TF-Luna frames: wrong baud rate or serial console still enabled"
    return None


def lidar_thread():
    while True:
        ser = open_lidar()
        if ser is None:
            time.sleep(2)
            continue
        buf, last_ok = bytearray(), time.time()
        while time.time() - last_ok < 4:
            try:
                d = ser.read(max(ser.in_waiting, 9))
            except Exception as e:
                LDIAG["msg"] = "Serial error: %s" % e
                break
            LDIAG["bytes"] += len(d)
            buf += d
            for dist, st, tmp in parse_frames(buf):
                last_ok = time.time()
                LDIAG["frames"] += 1
                if st == 65535:
                    LD["cm"], LDIAG["msg"] = None, "Signal saturated (target too close or too bright)"
                elif dist <= 0 or st < 30:
                    LD["cm"], LDIAG["msg"] = None, "No valid target (under 20 cm blind zone, nothing in range, or weak signal)"
                else:
                    LD.update(cm=round(dist - LIDAR_OFFSET_CM, 1), strength=st, temp=round(tmp, 1), t=time.time())
                    LDIAG["msg"] = "OK"
        try:
            ser.close()
        except Exception:
            pass
        LDIAG["msg"] = "Lost LiDAR data - rescanning..."
        LD["cm"] = None


def us_measure(trig, echo):
    """One HC-SR04 reading. Returns (cm or None, reason)."""
    trig.on()
    time.sleep(0.00002)
    trig.off()
    t0 = time.perf_counter()
    while not echo.value:
        if time.perf_counter() - t0 > 0.03:
            return None, "ECHO never went high: check TRIG/ECHO wires and 5V power"
    ts = time.perf_counter()
    while echo.value:
        if time.perf_counter() - ts > 0.03:
            return None, "ECHO stuck high: check the voltage divider / ECHO wire"
    return (time.perf_counter() - ts) * 34300.0 / 2.0, ""


def ultra_thread(trig, echo):
    recent, fails = collections.deque(maxlen=3), 0
    while True:
        try:
            d, why = us_measure(trig, echo)
        except Exception as e:
            d, why = None, "GPIO error: %s" % e
        if d is not None and 2 <= d <= 400:
            recent.append(d)
            fails = 0
            UDIAG["ok"] += 1
            UDIAG["msg"] = "OK"
            US.update(cm=round(float(np.median(recent)) - US_OFFSET_CM, 1), t=time.time())
        else:
            fails += 1
            UDIAG["fail"] += 1
            if fails >= 4:
                US["cm"] = None
                UDIAG["msg"] = why or "Out of range (under 2 cm or over 4 m)"
        time.sleep(0.065)


def sim_thread():
    t0 = time.time()
    while True:
        base = 70 + 65 * math.sin((time.time() - t0) / 6.0)
        if SIM_L:
