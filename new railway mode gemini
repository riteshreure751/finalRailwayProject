def current_shutdown_pass():
    """Shutdown password. If ROOT/shutdown_password.txt exists, its first line is used (no restart needed)."""
    try:
        with open(os.path.join(ROOT, "shutdown_password.txt")) as f:
            v = f.readline().strip()
            if v:
                return v
    except OSError:
        pass
    return SHUTDOWN_PASS


def _try_poweroff():
    """Runs the power-off command and returns (True, '') if it was accepted, else (False, real reason)."""
    if os.geteuid() == 0:
        cmds = [["systemctl", "poweroff"], ["shutdown", "-h", "now"], ["poweroff"]]
    else:
        cmds = [["sudo", "-n", "systemctl", "poweroff"], ["sudo", "-n", "shutdown", "-h", "now"], ["sudo", "-n", "poweroff"]]
    last = "no command worked"
    for c in cmds:
        try:
            r = subprocess.run(c, capture_output=True, text=True, timeout=8)
            if r.returncode == 0:
                return True, ""
            last = ((r.stderr or r.stdout or "").strip() or "exit code %d" % r.returncode)[:160]
        except FileNotFoundError:
            last = "%s not found" % c[0]
        except Exception as e:
            last = str(e)[:160]
    return False, last


@app.route("/api/shutdown", methods=["POST"])
def api_shutdown():
    pw = str((request.json or {}).get("password", "")).strip()
    if not hmac.compare_digest(pw.encode(), current_shutdown_pass().encode()):
        return jsonify(ok=False, error="Wrong shutdown password"), 403
    if os.name != "posix":
        return jsonify(ok=False, error="Shutdown only works on the Raspberry Pi"), 400
    train.stop("Shutdown")               # motor off first
    ok, why = _try_poweroff()
    if not ok:
        return jsonify(ok=False, error="Password OK but the shutdown command failed: %s" % why), 500
    LCD_OVERRIDE[0] = ("SHUTTING DOWN", "Then power off")
    return jsonify(ok=True)


