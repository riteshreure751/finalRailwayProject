RUN = {"p": None, "buf": Buf()}
TERM = {"p": None, "fd": None, "buf": Buf()}
ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07]*\x07|\x07|\x1b[=>]")


def run_reader(p, buf):
    while True:
        try:
            d = os.read(p.stdout.fileno(), 4096)
        except Exception:
            break
        if not d:
            break
        buf.add(d.decode("utf-8", "replace"))
    buf.add("\n[process finished, exit code %s]\n" % p.wait())


def term_start():
    if not pty:
        TERM["buf"].add("Terminal needs Linux/Raspberry Pi OS.\n")
        return
    master, slave = pty.openpty()
    env = dict(os.environ, TERM="dumb", PS1=r"\u@\h:\w\$ ")
    p = subprocess.Popen(["bash", "--noprofile", "--norc", "-i"], stdin=slave, stdout=slave, stderr=slave,
                         cwd=ROOT, env=env, preexec_fn=os.setsid, close_fds=True)
    os.close(slave)
    TERM["p"], TERM["fd"] = p, master

    def rd():
        while True:
            r, _, _ = select.select([master], [], [], 0.5)
            if r:
                try:
                    d = os.read(master, 4096)
                except OSError:
                    break
                if not d:
                    break
                TERM["buf"].add(ANSI.sub("", d.decode("utf-8", "replace")).replace("\r\n", "\n").replace("\r", ""))
            elif p.poll() is not None:
                break
        TERM["buf"].add("\n[shell closed - type something to restart]\n")
    threading.Thread(target=rd, daemon=True).start()


def term_ensure():
    if TERM["p"] is None or TERM["p"].poll() is not None:
        term_start()


