.trow .car{width:12px;color:var(--mut);font-size:12px}
.trow.more{color:var(--mut);cursor:default;font-style:italic}
.path{color:#cfdcf7;font-size:18px;margin:2px 0 4px;word-break:break-all}
.tabs{display:flex;gap:4px;margin-bottom:6px}
.tab{border:0;background:#0b1424;border-radius:6px 6px 0 0;padding:10px 20px;font-size:18px;cursor:pointer;color:#dbe5fb}
.tab.on{background:var(--blue);color:#fff;font-weight:600}
.pane{display:none;flex-direction:column;gap:6px}
.ebar{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.fname{color:var(--mut);font-size:14px;margin-right:auto;word-break:break-all}
.ed{position:relative;display:flex;height:190px;background:#0a1220;border:1px solid var(--line);border-radius:5px;overflow:hidden;font:14px/21px "DejaVu Sans Mono",Consolas,Menlo,monospace}
.gut{width:40px;flex:none;overflow:hidden;color:#6f82a8;text-align:right;padding:8px 8px 20px 0;border-right:1px solid var(--line);white-space:pre;user-select:none}
.code{position:relative;flex:1;min-width:0}
.code pre,.code textarea{position:absolute;inset:0;margin:0;padding:8px 10px 20px;font:inherit;tab-size:4;white-space:pre;overflow:auto;border:0;outline:0;background:transparent;resize:none;letter-spacing:0}
.code pre{pointer-events:none;overflow:hidden;color:#dbe6ff}
.code textarea{color:transparent;caret-color:#fff}
.k{color:#ff6b7a}.s{color:#9be37a}.c{color:#6f8fc0;font-style:italic}.n{color:#ffb86b}.f{color:#6bc1ff}
.out{height:104px;margin:0;background:#080f1c;border:1px solid var(--line);border-radius:5px;padding:7px 10px;overflow:auto;font:13px/18px "DejaVu Sans Mono",Consolas,monospace;white-space:pre-wrap;word-break:break-all;color:#cfe0ff}
.term{height:250px}
.irow{display:flex;gap:6px;align-items:center}
.irow input{flex:1;background:#080f1c;border:1px solid var(--line);border-radius:5px;padding:8px 10px;font:14px "DejaVu Sans Mono",Consolas,monospace;outline:0;min-width:0}
.irow input:focus{border-color:var(--blue)}
.toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);background:#16305c;border:1px solid #2f66c2;padding:11px 20px;border-radius:8px;opacity:0;pointer-events:none;transition:opacity .25s;z-index:30}
.toast.on{opacity:1}
.modal{position:fixed;inset:0;background:#000b;display:none;align-items:center;justify-content:center;z-index:40}
.modal.on{display:flex}
.modal .box{background:#101a30;border:1px solid var(--line);border-radius:10px;padding:26px 30px;max-width:420px;text-align:center}
.modal .box p{color:var(--mut)}.modal .row{display:flex;gap:12px;justify-content:center;margin-top:18px}
.modal input{width:100%;margin-top:6px;background:#080f1c;border:1px solid var(--line);border-radius:6px;padding:12px;font-size:20px;text-align:center;letter-spacing:6px;outline:0}
.modal input:focus{border-color:var(--blue)}
.modal .err{color:#ff6b6b;min-height:22px;margin-top:8px;font-size:15px}
@media(max-width:1150px){.top{grid-template-columns:1fr 1fr;grid-template-areas:"cam cam" "lidar ultra" "alert alert"}.bot{grid-template-columns:1fr}.app{grid-template-columns:70px 1fr}nav a span{display:none}header h1{font-size:22px}header .sub{font-size:15px}.pi{display:none}}
@media(max-width:700px){.abody{flex-direction:column;align-items:flex-start}.thumb{width:100%}.sensor .val,.sensor .val small{font-size:40px}}
