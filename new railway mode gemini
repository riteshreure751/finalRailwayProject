def pretty(name):
    return name.replace("_", " ").replace("-", " ").strip().title()


def is_clear_name(name):
    return "clear" in name.lower()


def _vote(S, labels, ncls, k=7):
    """S = similarity matrix (rows = queries, columns = stored samples). Returns (class index, confidence) per row."""
    k = max(1, min(k, S.shape[1]))
    top = np.argpartition(-S, k - 1, axis=1)[:, :k]
    w = np.maximum(np.take_along_axis(S, top, 1), 0.0) ** 6
    lab = labels[top]
    votes = np.zeros((S.shape[0], ncls), np.float64)
    rows = np.arange(S.shape[0])
    for j in range(k):
        np.add.at(votes, (rows, lab[:, j]), w[:, j])
    pred = votes.argmax(1)
    return pred, votes[rows, pred] / (votes.sum(1) + 1e-9)


FEAT_VER = 2   # bump when the feature extractor changes (old saved models are then ignored)


def hog_feat(gray):
    """HOG-style shape descriptor in plain numpy/OpenCV (128x96 gray -> 5940 numbers). Works on any OpenCV version."""
    g = gray.astype(np.float32)
    gx, gy = cv2.Sobel(g, cv2.CV_32F, 1, 0, ksize=1), cv2.Sobel(g, cv2.CV_32F, 0, 1, ksize=1)
    mag = np.sqrt(gx * gx + gy * gy)
    b = np.minimum(((np.arctan2(gy, gx) * (180.0 / np.pi)) % 180.0 / 20.0).astype(np.int32), 8)
    cells = np.zeros((12, 16, 9), np.float32)                     # 8x8-pixel cells, 9 orientation bins
    for k in range(9):
        cells[:, :, k] = (mag * (b == k)).reshape(12, 8, 16, 8).sum((1, 3))
    blk = np.concatenate([cells[:-1, :-1], cells[:-1, 1:], cells[1:, :-1], cells[1:, 1:]], axis=2)   # 2x2-cell blocks
    blk /= (np.linalg.norm(blk, axis=2, keepdims=True) + 1e-6)
    return blk.flatten()


class Detector:
    """
    Camera brain. Two parts work together:
      1) YOLOv4-tiny (if its files are in models/)  -> names animals/people/objects (cow, giraffe, ...)
      2) Dataset classifier (trained from dataset/)  -> learns YOUR objects and YOUR clear track
    """
    def __init__(self):
        self.lock = threading.RLock()
        self.yolo, self.yolo_out = None, None
        self.feats, self.labels, self.names, self.counts = None, None, [], {}
        self.training, self.msg, self.report = False, "", ""
        self.npz = os.path.join(ROOT, "models", "classifier.npz")
        cfg = os.path.join(ROOT, "models", "yolov4-tiny.cfg")
        wts = os.path.join(ROOT, "models", "yolov4-tiny.weights")
        if os.path.exists(cfg) and os.path.exists(wts):
            try:
                self.yolo = cv2.dnn.readNetFromDarknet(cfg, wts)
                self.yolo.setPreferableBackend(cv2.dnn.DNN_BACKEND_OPENCV)
                self.yolo.setPreferableTarget(cv2.dnn.DNN_TARGET_CPU)
                self.yolo_out = self.yolo.getUnconnectedOutLayersNames()
                print("[Detector] YOLOv4-tiny loaded")
            except Exception as e:
                self.yolo = None
                print("[Detector] YOLO load failed: %s" % e)
        else:
            print("[Detector] YOLO files not found in models/ (dataset classifier only)")
        self.load()

    # ---- dataset classifier ----
    def feat(self, f):
        img = cv2.resize(f, (128, 96))
        h = hog_feat(cv2.cvtColor(img, cv2.COLOR_BGR2GRAY))
        hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)
        c = cv2.calcHist([hsv], [0, 1, 2], None, [8, 4, 4], [0, 180, 0, 256, 0, 256]).flatten().astype(np.float32)
        h /= (np.linalg.norm(h) + 1e-6)
        c /= (np.linalg.norm(c) + 1e-6)
        v = np.concatenate([h, c])
        return v / (np.linalg.norm(v) + 1e-6)

    @staticmethod
    def variants(img):
        """Original + mirror + brighter + darker, so lighting changes and left/right sides are learned."""
        return [img, cv2.flip(img, 1), cv2.convertScaleAbs(img, alpha=1.3, beta=10), cv2.convertScaleAbs(img, alpha=0.7, beta=-10)]

    def load(self):
        if not os.path.exists(self.npz):
            return
        try:
            z = np.load(self.npz, allow_pickle=False)
            names = [str(x) for x in z["names"]]
            counts = json.loads(str(z["counts"]))
            report = str(z["report"]) if "report" in z.files else ""
            if (int(z["ver"]) if "ver" in z.files else 1) != FEAT_VER:
                self.msg = "Saved dataset model is from an older version - press 'Train from dataset'"
                print("[Detector] " + self.msg)
                return
            with self.lock:
                self.feats, self.labels = z["feats"].astype(np.float32), z["labels"]
                self.names, self.counts, self.report = names, counts, report
            print("[Detector] dataset model loaded: %s" % counts)
        except Exception as e:
            print("[Detector] dataset model load failed: %s" % e)

    def validate(self, X, y, g, o, names):
        """Leave-one-image-out test: each original photo is judged using only the OTHER photos."""
        oi = np.where(o)[0]
        S = X[oi] @ X.T
        S[g[oi][:, None] == g[None, :]] = -np.inf
        pred, _ = _vote(S, y, len(names))
        true = y[oi]
        clear = np.array([is_clear_name(n) for n in names])
        tc, pc = clear[true], clear[pred]
        missed = float(np.mean(pc[~tc])) if (~tc).any() else 0.0
        false_alarm = float(np.mean(~pc[tc])) if tc.any() else 0.0
        per = []
        for i, n in enumerate(names):
            m = true == i
            if m.any():
                per.append("%s %d%%" % (n, round(100 * float(np.mean(pred[m] == i)))))
        return "Accuracy %d%% | missed obstacles %d%% | false alarms %d%% (%s)" % (
            round(100 * float(np.mean(pred == true))), round(100 * missed), round(100 * false_alarm), ", ".join(per))

    def train(self):
        if self.training:
            return
        self.training, self.msg = True, "Training: reading images..."
        try:
            base = os.path.join(ROOT, "dataset")
            rng = random.Random(1)
            X, y, g, o, names, counts, gid = [], [], [], [], [], {}, 0
            for name in sorted(os.listdir(base)):
                d = os.path.join(base, name)
                if not os.path.isdir(d):
                    continue
                files = [x for x in sorted(os.listdir(d)) if x.lower().endswith((".jpg", ".jpeg", ".png"))]
                if len(files) > MAX_PER_CLASS:
                    files = sorted(rng.sample(files, MAX_PER_CLASS))
                idx, n = len(names), 0
                for fn in files:
                    img = cv2.imread(os.path.join(d, fn))
                    if img is None:
                        continue
                    for k, v in enumerate(self.variants(img)):
                        X.append(self.feat(v)); y.append(idx); g.append(gid); o.append(k == 0)
                    gid += 1
                    n += 1
                    if n % 5 == 0:
                        self.msg = "Training: %s (%d images)..." % (name, n)
                if n:
                    names.append(name)
                    counts[name] = n
            if not any(is_clear_name(n) for n in names):
                self.msg = "Cannot train: put images in a folder whose name contains 'clear' (e.g. clear_no_obstacle)"
                return
            if not any(not is_clear_name(n) for n in names):
                self.msg = "Cannot train: add at least one obstacle folder with images (e.g. obstacle, cow)"
                return
            self.msg = "Training: testing accuracy..."
            X, y, g, o = np.array(X, np.float32), np.array(y, np.int32), np.array(g), np.array(o)
            report = self.validate(X, y, g, o, names)
            np.savez(self.npz, feats=X.astype(np.float16), labels=y, names=np.array(names),
                     counts=np.array(json.dumps(counts)), report=np.array(report), ver=np.array(FEAT_VER))
            with self.lock:
                self.feats, self.labels, self.names, self.counts, self.report = X, y, names, counts, report
            few = ["%s (%d)" % (k, v) for k, v in counts.items() if v < 30]
            self.msg = "Training finished" + ((" - add more images: " + ", ".join(few)) if few else "")
            print("[Detector] %s | %s" % (self.msg, report))
        except Exception as e:
            self.msg = "Training failed: %s" % e
            print("[Detector] " + self.msg)
        finally:
            self.training = False

    def classify(self, f):
        v = self.feat(f)
        pred, conf = _vote((self.feats @ v)[None, :], self.labels, len(self.names))
        return self.names[int(pred[0])], float(conf[0])

    # ---- YOLO ----
    def run_yolo(self, f):
        h, w = f.shape[:2]
        blob = cv2.dnn.blobFromImage(f, 1 / 255.0, (YOLO_SIZE, YOLO_SIZE), swapRB=True, crop=False)
        self.yolo.setInput(blob)
        outs = self.yolo.forward(self.yolo_out)
        boxes, confs, ids = [], [], []
        for o in outs:
            for row in o:
                sc = row[5:]
                cid = int(np.argmax(sc))
                cf = float(row[4] * sc[cid])
                if cf < YOLO_CONF or cid >= len(COCO):
                    continue
                bw, bh = row[2] * w, row[3] * h
                boxes.append([int(row[0] * w - bw / 2), int(row[1] * h - bh / 2), int(bw), int(bh)])
                confs.append(cf)
                ids.append(cid)
        best = None
        if boxes:
            keep = cv2.dnn.NMSBoxes(boxes, confs, YOLO_CONF, 0.45)
            for i in np.array(keep).flatten():
                name = COCO[ids[i]]
                if name in IGNORE_YOLO:
                    continue
                x, y, bw, bh = boxes[i]
                cx, bottom = (x + bw / 2) / w, (y + bh) / h
                if 0.1 < cx < 0.9 and bottom > 0.35 and bw * bh > 0.01 * w * h:
                    score = confs[i] * bw * bh
                    if best is None or score > best[0]:
                        best = (score, pretty(name), confs[i], (max(x, 0) / w, max(y, 0) / h, min(x + bw, w) / w, min(y + bh, h) / h))
        return best[1:] if best else None

    def ready(self):
        return self.yolo is not None or self.feats is not None

    def detect(self, f):
        """Returns dict(found, label, conf, source, box, ready)."""
        with self.lock:
            res = {"found": False, "label": None, "conf": 0.0, "source": None, "box": None, "ready": self.ready()}
            cname, cconf = (None, 0.0)
            if self.feats is not None:
                cname, cconf = self.classify(f)
            yb = self.run_yolo(f) if self.yolo is not None else None
            if cname is not None and not is_clear_name(cname) and cconf >= CLS_CONF:
                label, src = pretty(cname), "Dataset"
                if label.lower() == "obstacle" and yb:      # generic folder -> use YOLO's specific name
                    label, src = yb[0], "YOLO"
                res.update(found=True, label=label, conf=round(cconf, 2), source=src, box=yb[2] if yb and src == "YOLO" else None)
            elif yb:
                res.update(found=True, label=yb[0], conf=round(yb[1], 2), source="YOLO", box=yb[2])
            return res

    def info(self):
        parts = ["YOLO: " + ("ready" if self.yolo is not None else "not installed")]
        parts.append("Dataset model: " + (", ".join("%s %d" % (k, v) for k, v in self.counts.items()) if self.feats is not None else "not trained yet"))
        if self.feats is not None and self.report:
            parts.append(self.report)
        if self.msg:
            parts.append(self.msg)
        return {"yolo": self.yolo is not None, "classifier": self.feats is not None, "training": self.training,
                "classes": self.names, "text": " | ".join(parts)}

