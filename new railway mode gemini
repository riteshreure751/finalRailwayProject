CHECK = {"snap": None, "id": 0, "hist": collections.deque(maxlen=8)}


@app.route("/api/check", methods=["GET", "POST"])
def api_check():
    """Combined obstacle check using Camera + LiDAR + Ultrasonic."""
    if request.method == "GET":
        return jsonify(list(CHECK["hist"]))
    lv = sval(LD)
    uv = sval(US) if USE_ULTRASONIC else None
    vals = [v for v in (lv, uv) if v is not None]
    near = min(vals) if vals else None
    fr = camera.get_frame()
    r = detector.detect(fr) if fr is not None else {"found": False, "label": None, "conf": 0.0, "source": None, "box": None, "ready": detector.ready()}

    sensor_obst = near is not None and near <= SLOW_CM
    cam_obst = bool(r["found"])
    sources = []
    if lv is not None and lv <= SLOW_CM:
        sources.append("LiDAR %.1fcm" % lv)
    if uv is not None and uv <= SLOW_CM:
        sources.append("Ultrasonic %.1fcm" % uv)
    if cam_obst:
        sources.append("Camera (%s)" % (r["label"] or "object"))

    if sensor_obst or cam_obst:
        level = "danger"
        lbl = r["label"] or ("Obstacle" if sensor_obst else "Object")
        d_str = " @ %.1fcm" % near if near is not None else ""
        verdict = "OBSTACLE: %s%s (%s)" % (lbl.upper(), d_str, ", ".join(sources))
    elif fr is None and near is None:
        level, verdict = "error", "SENSORS & CAMERA NOT READY"
    else:
        level, verdict = "ok", "TRACK CLEAR - camera, LiDAR & ultrasonic clear"

    color = {"danger": (60, 60, 255), "ok": (120, 230, 90)}.get(level, (200, 200, 200))
    if fr is not None:
        img = annotate(fr, verdict, r.get("box"), color)
        CHECK["snap"], CHECK["id"] = cv2.imencode(".jpg", img, [cv2.IMWRITE_JPEG_QUALITY, 85])[1].tobytes(), CHECK["id"] + 1

    res = {
        "time": datetime.datetime.now().strftime("%H:%M:%S"),
        "level": level,
        "verdict": verdict,
        "distance": near,
        "lidar_cm": lv,
        "ultra_cm": uv,
        "camera": ("object seen" if r["found"] else ("nothing seen" if r["ready"] else ("no model" if fr is not None else "no frame"))),
        "label": r["label"] or ("Obstacle" if sensor_obst else None),
        "conf": r["conf"],
        "source": ", ".join(sources) if sources else ("Camera+LiDAR+Ultrasonic" if (r["ready"] or near is not None) else None),
        "snap_id": CHECK["id"],
    }
    CHECK["hist"].append(res)
    try:
        with open(os.path.join(ROOT, "logs", "obstacle_checks.log"), "a") as fh:
            fh.write(datetime.datetime.now().isoformat(timespec="seconds") + " " + json.dumps(res) + "\n")
    except Exception:
        pass
    return jsonify(res)


