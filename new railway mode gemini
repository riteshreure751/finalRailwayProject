def lcd_thread():
    if not ON_PI:
        LCDIAG["msg"] = "off (not on a Raspberry Pi)"
        return
    if _smbus is None:
        LCDIAG["msg"] = "smbus missing: sudo apt install python3-smbus"
        return
    lcd, last, last_try, last_ip = None, ["", ""], 0.0, 0.0
    while True:
        try:
            if time.time() - last_ip > 10:
                last_ip = time.time()
                try:
                    ips = [x for x in subprocess.check_output(["hostname", "-I"], timeout=2).decode().split() if "." in x]
                    IPTXT[0] = ips[0] if ips else "no network"
                except Exception:
                    IPTXT[0] = "no network"
            if lcd is None:
                if time.time() - last_try < 5:
                    time.sleep(0.5)
                    continue
                last_try = time.time()
                lcd = LCD1602(LCD_BUS, LCD_ADDR)
                LCDIAG["msg"] = "OK at 0x%02X" % lcd.addr
                lcd.text(0, "RAILWAY SYSTEM")
                lcd.text(1, "IP " + IPTXT[0])
                last = ["", ""]
                time.sleep(2.5)
            for row, t in enumerate(lcd_lines()):
                t = t[:16].ljust(16)
                if t != last[row]:
                    lcd.text(row, t)
                    last[row] = t
        except Exception as e:
            LCDIAG["msg"] = "LCD error: %s" % e
            lcd = None
        time.sleep(0.25)

