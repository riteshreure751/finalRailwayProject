# ------------------------------ 16x2 I2C LCD --------------------------------
LCDIAG = {"msg": "starting..."}
LCD_OVERRIDE = [None]
IPTXT = ["no network"]


class LCD1602:
    """HD44780 16x2 behind a PCF8574 I2C backpack (RS=P0 RW=P1 E=P2 BL=P3 D4-D7=P4-P7)."""
    def __init__(self, bus=1, addr=None):
        self.bus, self.bl, self.addr = _smbus.SMBus(bus), 0x08, None
        cands = [addr] if addr else [0x27, 0x3F] + [a for a in list(range(0x20, 0x28)) + list(range(0x38, 0x40)) if a not in (0x27, 0x3F)]
        for a in cands:
            try:
                self.bus.write_byte(a, self.bl)
                self.addr = a
                break
            except OSError:
                continue
        if self.addr is None:
            raise RuntimeError("no I2C LCD found - check SDA/SCL/VCC/GND and that I2C is enabled")
        time.sleep(0.05)
        for n in (3, 3, 3, 2):
            self._nib(n, 0)
            time.sleep(0.005)
        for c in (0x28, 0x0C, 0x06, 0x01):
            self._send(c, 0)
            time.sleep(0.003)

    def _w(self, d):
        self.bus.write_byte(self.addr, d | self.bl)

    def _nib(self, n, rs):
        b = (n << 4) | rs
        self._w(b | 0x04)
        time.sleep(0.0005)
        self._w(b & ~0x04)
        time.sleep(0.0002)

    def _send(self, v, rs):
        self._nib(v >> 4, rs)
        self._nib(v & 0x0F, rs)

    def text(self, row, s):
        self._send(0x80 | (0x40 if row else 0x00), 0)
        for ch in str(s)[:16].ljust(16):
            self._send(ord(ch) if 32 <= ord(ch) < 127 else 63, 1)


def _cm(v):
