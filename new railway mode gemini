# =============================== SETTINGS ====================================
# --- TF-Luna LiDAR ---
LIDAR_PORT, LIDAR_BAUD = "/dev/serial0", 115200
LIDAR_OFFSET_CM = 13.0          # calibration offset added to every LiDAR reading
LIDAR_MIN_STRENGTH = 100        # datasheet: below 100 the distance is unreliable (65535 = saturated)
# --- HC-SR04 ---
US_TRIG, US_ECHO = 23, 24       # BCM numbers
US_OFFSET_CM = 0.0
US_MIN_CM, US_MAX_CM = 2.0, 400.0
# --- Camera ---
FRAME_SIZE = (640, 480)         # Picamera2 RGB888
# --- Fusion ---
CRITICAL_CM = 40.0              # lidar / ultrasonic stop distance
SENSOR_MAX_AGE = 0.7            # seconds before a sensor reading counts as stale (shown as ---)
# --- Vision (all tunable with command-line options too) ---
DEFAULT_ROI = (0.10, 0.50, 0.90, 0.95)   # x0, y0, x1, y1 as fractions of the frame: the track corridor ahead
DEFAULT_MIN_AREA = 1500         # contour area (pixels) below this is noise
WARMUP_FRAMES = 60              # frames used to learn the empty-track background
MOG_HISTORY = 300
MOG_VAR_THRESHOLD = 40          # higher = less sensitive (fewer false alarms from texture / light flicker)
BG_LEARNING_RATE = 0.002        # slow rolling background; set to 0 while an obstacle is present
SCENE_CHANGE_RATIO = 0.55       # more than 55 % of the ROI changed = camera moved / lights switched, not an obstacle
SCENE_RELEARN_RATE = 0.05
ZONE_MIN_OVERLAP_PX = 15        # a blob counts for a zone when it overlaps it by at least this many pixels
CONFIRM_ON, CONFIRM_MAX = 3, 6  # frames needed to switch a zone ON; it switches OFF after decaying to 0
# --- LCD ---
LCD_ADDR_DEFAULT = 0x27
LCD_PERIOD = 0.5                # seconds between LCD refreshes
# --- Colours (BGR) ---
RED, ORANGE, GREEN, YELLOW, BLUE, WHITE = (60, 60, 255), (0, 165, 255), (90, 220, 90), (0, 230, 255), (255, 140, 40), (255, 255, 255)
# =============================================================================

ZONES = ("LEFT", "CENTER", "RIGHT")
Decision = collections.namedtuple("Decision", "level label lcd reason color")


# ------------------------------- shared state --------------------------------
class SensorHub:
    """Thread-safe storage for the latest LiDAR / ultrasonic readings (protected by a Lock)."""
    def __init__(self):
        self.lock = threading.Lock()
        self._lidar = (None, 0, 0.0)       # cm, strength, timestamp
        self._ultra = (None, 0.0)          # cm, timestamp
        self.status = {"lidar": "starting...", "ultra": "starting..."}

    def set_lidar(self, cm, strength=0):
        with self.lock:
            self._lidar = (cm, strength, time.time())

    def set_ultra(self, cm):
        with self.lock:
            self._ultra = (cm, time.time())

    def set_status(self, name, msg):
        with self.lock:
            self.status[name] = msg

    def snapshot(self):
        now = time.time()
        with self.lock:
            lcm, lst, lt = self._lidar
            ucm, ut = self._ultra
            return {"lidar_cm": lcm if (lcm is not None and now - lt < SENSOR_MAX_AGE) else None,
                    "lidar_strength": lst,
                    "ultra_cm": ucm if (ucm is not None and now - ut < SENSOR_MAX_AGE) else None,
                    "status": dict(self.status)}


class LCDText:
    """The two LCD lines. The main loop writes them, the LCD thread reads them."""
    def __init__(self):
        self.lock = threading.Lock()
        self.lines = ("RAILWAY SAFETY", "STARTING...")

    def set(self, l1, l2):
        with self.lock:
            self.lines = (l1, l2)

    def get(self):
        with self.lock:
            return self.lines


def fit16(text):
    """Exactly 16 characters: truncated or space-padded, printable ASCII only."""
    return "".join(c if 32 <= ord(c) < 127 else "?" for c in str(text))[:16].ljust(16)


# ------------------------------ TF-Luna (UART) -------------------------------
class TFLunaReader(threading.Thread):
    """Reads 9-byte frames  59 59 DistL DistH StrL StrH TempL TempH Checksum  at 115200 baud."""
    def __init__(self, hub, stop):
        super().__init__(name="tfluna", daemon=True)
        self.hub, self.stop = hub, stop

    @staticmethod
    def parse(buf):
        """Extract every valid frame from the bytearray (edited in place). Returns [(dist_cm, strength)]."""
        out = []
        while len(buf) >= 9:
            if buf[0] == 0x59 and buf[1] == 0x59 and (sum(buf[:8]) & 0xFF) == buf[8]:
                out.append((buf[2] | (buf[3] << 8), buf[4] | (buf[5] << 8)))
                del buf[:9]
            else:
                del buf[0]
        return out

    def run(self):
        if serial is None:
            self.hub.set_status("lidar", "pyserial missing (sudo apt install python3-serial)")
            return
        ser, buf = None, bytearray()
        try:
            while not self.stop.is_set():
                if ser is None:
                    try:
                        ser = serial.Serial(LIDAR_PORT, LIDAR_BAUD, timeout=0.1)
                        ser.reset_input_buffer()
                        buf = bytearray()
                        self.hub.set_status("lidar", "port open, waiting for frames")
                    except Exception as e:
                        self.hub.set_status("lidar", "cannot open %s: %s" % (LIDAR_PORT, e))
                        self.stop.wait(2.0)
                        continue
                try:
                    data = ser.read(max(ser.in_waiting, 9))
                except Exception as e:
                    self.hub.set_status("lidar", "serial error: %s" % e)
                    try:
                        ser.close()
                    except Exception:
                        pass
                    ser = None
                    self.hub.set_lidar(None)
                    continue
                buf += data
                if len(buf) > 1024:
                    del buf[:-64]
                for dist, strength in self.parse(buf):
                    if dist > 0 and LIDAR_MIN_STRENGTH <= strength < 65535:
                        self.hub.set_lidar(dist + LIDAR_OFFSET_CM, strength)      # +13 cm calibration
                        self.hub.set_status("lidar", "OK")
                    else:
                        self.hub.set_lidar(None, strength)
                        self.hub.set_status("lidar", "no valid target (signal %d)" % strength)
        finally:
            if ser is not None:
                try:
                    ser.close()
                except Exception:
                    pass


# ------------------------------ HC-SR04 (GPIO) -------------------------------
class UltrasonicReader(threading.Thread):
    def __init__(self, hub, stop):
        super().__init__(name="ultrasonic", daemon=True)
        self.hub, self.stop = hub, stop

    @staticmethod
    def _measure():
        GPIO.output(US_TRIG, True)
        time.sleep(0.00001)                                   # 10 us trigger pulse
        GPIO.output(US_TRIG, False)
        t0 = time.perf_counter()
        while GPIO.input(US_ECHO) == 0:
            if time.perf_counter() - t0 > 0.03:
                return None, "ECHO never went high (check wiring / 5V)"
        ts = time.perf_counter()
        while GPIO.input(US_ECHO) == 1:
            if time.perf_counter() - ts > 0.03:
                return None, "ECHO stuck high (check divider)"
        return (time.perf_counter() - ts) * 34300.0 / 2.0, ""

    def run(self):
        if GPIO is None:
            self.hub.set_status("ultra", "RPi.GPIO missing (sudo apt install python3-rpi-lgpio)")
            return
        try:
            GPIO.setwarnings(False)
            GPIO.setmode(GPIO.BCM)
            GPIO.setup(US_TRIG, GPIO.OUT, initial=GPIO.LOW)
            GPIO.setup(US_ECHO, GPIO.IN)
        except Exception as e:
            self.hub.set_status("ultra", "GPIO setup failed: %s" % e)
            return
        time.sleep(0.1)
        recent, fails = collections.deque(maxlen=3), 0
        while not self.stop.is_set():
            try:
                d, why = self._measure()
            except Exception as e:
                d, why = None, "GPIO error: %s" % e
            if d is not None and US_MIN_CM <= d <= US_MAX_CM:
                recent.append(d)
                fails = 0
                self.hub.set_ultra(float(np.median(recent)) + US_OFFSET_CM)     # median of 3 removes spikes
                self.hub.set_status("ultra", "OK")
            else:
                fails += 1
                if fails >= 4:
                    self.hub.set_ultra(None)
                    self.hub.set_status("ultra", why or "out of range")
            self.stop.wait(0.065)


# ------------------------------- 16x2 I2C LCD --------------------------------
class LCDDisplay(threading.Thread):
    """Refreshes the LCD every 0.5 s in its own thread, so slow I2C writes never slow the video."""
    def __init__(self, text, address, stop):
        super().__init__(name="lcd", daemon=True)
        self.text, self.address, self.stop = text, address, stop
        self.status = "starting..."

    def _open(self):
        addrs = [self.address] + [a for a in (0x27, 0x3F) if a != self.address]
        last = None
        for a in addrs:
            try:
                lcd = CharLCD("PCF8574", a, port=1, cols=16, rows=2, charmap="A02", auto_linebreaks=False)
                lcd.clear()
                self.status = "OK at 0x%02X" % a
                return lcd
            except Exception as e:
                last = e
        raise RuntimeError("no LCD found (%s)" % last)

    def run(self):
        if CharLCD is None:
            self.status = "RPLCD missing (pip3 install RPLCD --break-system-packages)"
            return
        lcd, shown = None, ["", ""]
        try:
            while not self.stop.is_set():
                try:
                    if lcd is None:
                        lcd = self._open()
                        shown = ["", ""]
                    for row, line in enumerate(self.text.get()):
                        line = fit16(line)
                        if line != shown[row]:                 # write only what changed
                            lcd.cursor_pos = (row, 0)
                            lcd.write_string(line)
                            shown[row] = line
                except Exception as e:
                    self.status = "LCD error: %s" % e
                    lcd = None
                self.stop.wait(LCD_PERIOD)
        finally:
            if lcd is not None:
                try:
                    lcd.clear()
                    lcd.close(clear=False)
                except Exception:
                    pass


# --------------------------------- camera ------------------------------------
class CameraSource:
    """Picamera2 (RGB888, 640x480). Falls back to a USB webcam if Picamera2 is unavailable."""
    def __init__(self, size=FRAME_SIZE):
        self.size, self.cam, self.cap, self.kind = size, None, None, "none"

    def start(self):
        if Picamera2 is not None:
            try:
                self.cam = Picamera2()
                try:
                    cfg = self.cam.create_video_configuration(main={"size": self.size, "format": "RGB888"},
                                                              controls={"FrameRate": 30.0})
                except Exception:
                    cfg = self.cam.create_video_configuration(main={"size": self.size, "format": "RGB888"})
                self.cam.configure(cfg)
                self.cam.start()
                self.kind = "Picamera2"
                time.sleep(1.0)                                # let auto-exposure settle
                return
            except Exception as e:
                print("[Camera] Picamera2 failed (%s) - trying USB camera" % e)
                self.cam = None
        cap = cv2.VideoCapture(0)
        if not cap.isOpened():
            raise RuntimeError("No camera found. Check the CSI ribbon cable (power off!) and run: rpicam-hello")
        cap.set(cv2.CAP_PROP_FRAME_WIDTH, self.size[0])
        cap.set(cv2.CAP_PROP_FRAME_HEIGHT, self.size[1])
        self.cap, self.kind = cap, "USB/OpenCV"

    def read(self):
        """Returns a BGR frame (Picamera2 'RGB888' is already BGR byte order, which is what OpenCV wants)."""
        if self.cam is not None:
            fr = self.cam.capture_array("main")
        else:
            ok, fr = self.cap.read()
            if not ok:
                return None
        if fr.ndim == 3 and fr.shape[2] == 4:
            fr = fr[:, :, :3]
        return np.ascontiguousarray(fr)

    def stop(self):
        if self.cam is not None:
            try:
                self.cam.stop()
            except Exception:
                pass
            try:
                self.cam.close()
            except Exception:
                pass
            self.cam = None
        if self.cap is not None:
            self.cap.release()
            self.cap = None


# ---------------------------- track corridor vision --------------------------
class TrackVision:
    """
    Learns the empty track with MOG2, then reports anything NEW or MOVING inside the ROI.
    Static rails and sleepers become part of the background and are ignored.
    ROI = lower part of the frame, split into 3 equal zones: LEFT | CENTER | RIGHT.
    """
    def __init__(self, roi, min_area, center_area, warmup):
        self.roi, self.min_area, self.center_area, self.warmup = roi, min_area, center_area, warmup
        self.k_open = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
        self.k_close = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (15, 15))
        self.roi_px, self.last_mask = (0, 0, 1, 1), None
        self.reset()

    def reset(self):
        self.mog = cv2.createBackgroundSubtractorMOG2(history=MOG_HISTORY, varThreshold=MOG_VAR_THRESHOLD, detectShadows=True)
        self.frames = 0
        self.count = {z: 0 for z in ZONES}
        self.active = {z: False for z in ZONES}
        self.obstacles = []                 # [{"box": (x, y, w, h) in frame coords, "area": px, "zones": [...]}]
        self.scene_change = False

    @property
    def learning(self):
        return self.frames <= self.warmup

    def roi_rect(self, w, h):
        x0, y0, x1, y1 = self.roi
        return int(x0 * w), int(y0 * h), int(x1 * w), int(y1 * h)

    def process(self, frame):
        h, w = frame.shape[:2]
        x0, y0, x1, y1 = self.roi_px = self.roi_rect(w, h)
        gray = cv2.GaussianBlur(cv2.cvtColor(frame[y0:y1, x0:x1], cv2.COLOR_BGR2GRAY), (7, 7), 0)
        self.frames += 1
        self.obstacles, self.scene_change = [], False

        if self.learning:                                     # learn the empty track first
            self.mog.apply(gray, learningRate=-1)
            self.last_mask = np.zeros(gray.shape, np.uint8)
            self.active = {z: False for z in ZONES}
            return

        lr = 0.0 if any(self.active.values()) else BG_LEARNING_RATE     # freeze learning while an obstacle is present
        fg = self.mog.apply(gray, learningRate=lr)
        binary = cv2.threshold(fg, 200, 255, cv2.THRESH_BINARY)[1]      # 255 = foreground, drops the grey shadow value
        binary = cv2.morphologyEx(binary, cv2.MORPH_OPEN, self.k_open)
        binary = cv2.morphologyEx(binary, cv2.MORPH_CLOSE, self.k_close)
        self.last_mask = binary
        present = {z: False for z in ZONES}

        if cv2.countNonZero(binary) / float(binary.size) > SCENE_CHANGE_RATIO:
            self.scene_change = True                          # whole view changed: camera moved or lights flipped
            self.mog.apply(gray, learningRate=SCENE_RELEARN_RATE)
        else:
            zw = binary.shape[1] / 3.0
            cnts = cv2.findContours(binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)[-2]
            for c in cnts:
                area = cv2.contourArea(c)
                if area <= self.min_area:                     # noise filter
                    continue
                bx, by, bw, bh = cv2.boundingRect(c)
                zones = []
                for i, z in enumerate(ZONES):
                    za, zb = i * zw, (i + 1) * zw
                    overlap = min(bx + bw, zb) - max(bx, za)
                    if overlap >= ZONE_MIN_OVERLAP_PX and (z != "CENTER" or area > self.center_area):
                        zones.append(z)
                        present[z] = True
                if zones:
                    self.obstacles.append({"box": (bx + x0, by + y0, bw, bh), "area": int(area), "zones": zones})

        for z in ZONES:                                       # debounce: ON after 3 frames, OFF after it decays to 0
            self.count[z] = min(self.count[z] + 1, CONFIRM_MAX) if present[z] else max(self.count[z] - 1, 0)
            self.active[z] = (self.count[z] >= CONFIRM_ON) if not self.active[z] else (self.count[z] > 0)


# ------------------------------ sensor fusion --------------------------------
def fuse(snap, active, learning=False):
    """Decision matrix. Returns a Decision(level, label, lcd_line2, reason, colour)."""
    lid, ult = snap["lidar_cm"], snap["ultra_cm"]
    reasons = []
    if lid is not None and lid < CRITICAL_CM:
        reasons.append("LiDAR %.0f cm" % lid)
    if ult is not None and ult < CRITICAL_CM:
        reasons.append("ultrasonic %.0f cm" % ult)
    range_hit = bool(reasons)
    if active["CENTER"]:
        reasons.append("camera CENTER")

    if range_hit or active["CENTER"]:
        return Decision("CRITICAL", "CRITICAL STOP", "STOP: CENTER!" if active["CENTER"] else "STOP: NEAR OBJ!",
                        ", ".join(reasons), RED)
    left, right = active["LEFT"], active["RIGHT"]
    if left or right:
        side = "BOTH SIDES" if (left and right) else ("LEFT OBST" if left else "RIGHT OBST")
        return Decision("CAUTION", "CAUTION: SIDE OBST", "WARN: " + side, "camera " + side.lower(), ORANGE)
    return Decision("CLEAR", "CLEAR", "STATUS: LEARN BG" if learning else "STATUS: CLEAR", "", GREEN)


def lcd_line1(lidar_cm, ultra_cm):
    """L:142cm U:085cm  (---  when a sensor has no valid reading)."""
    fmt = lambda v: "---" if v is None else "%03d" % max(0, min(999, int(round(v))))
    return "L:%scm U:%scm" % (fmt(lidar_cm), fmt(ultra_cm))


# --------------------------------- drawing -----------------------------------
def draw_overlay(frame, vision, decision, snap, fps, show_mask):
    out = frame.copy()
    x0, y0, x1, y1 = vision.roi_px
    zw = (x1 - x0) / 3.0
    cv2.rectangle(out, (x0, y0), (x1, y1), BLUE, 2)                              # ROI box
    for i, z in enumerate(ZONES):
        xa = int(x0 + i * zw)
        if i:
            cv2.line(out, (xa, y0), (xa, y1), BLUE, 1)
        col = RED if vision.active[z] else (180, 180, 180)
        cv2.putText(out, z, (xa + 6, y1 - 8), cv2.FONT_HERSHEY_SIMPLEX, 0.55, col, 2)
    for ob in vision.obstacles:                                                  # obstacle boxes with zone labels
        bx, by, bw, bh = ob["box"]
        cv2.rectangle(out, (bx, by), (bx + bw, by + bh), YELLOW, 2)
        cv2.putText(out, "+".join(z[0] for z in ob["zones"]) + " " + "/".join(ob["zones"]) if False else "/".join(ob["zones"]),
                    (bx, max(by - 6, 14)), cv2.FONT_HERSHEY_SIMPLEX, 0.5, YELLOW, 2)
    cv2.rectangle(out, (0, 0), (out.shape[1], 52), (25, 25, 25), -1)             # status banner
    cv2.putText(out, decision.label, (10, 24), cv2.FONT_HERSHEY_SIMPLEX, 0.8, decision.color, 2)
    sens = "LiDAR %s  Ultra %s  FPS %.0f" % (
        "---" if snap["lidar_cm"] is None else "%.0fcm" % snap["lidar_cm"],
        "---" if snap["ultra_cm"] is None else "%.0fcm" % snap["ultra_cm"], fps)
    cv2.putText(out, sens, (10, 46), cv2.FONT_HERSHEY_SIMPLEX, 0.5, WHITE, 1)
    if vision.learning:
        cv2.putText(out, "LEARNING BACKGROUND - keep the track empty", (10, y0 - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.55, YELLOW, 2)
    elif vision.scene_change:
        cv2.putText(out, "SCENE CHANGE - relearning", (10, y0 - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.55, YELLOW, 2)
    if show_mask and vision.last_mask is not None:
        m = cv2.cvtColor(cv2.resize(vision.last_mask, (200, 90)), cv2.COLOR_GRAY2BGR)
        out[56:146, out.shape[1] - 204:out.shape[1] - 4] = m
        cv2.rectangle(out, (out.shape[1] - 204, 56), (out.shape[1] - 4, 146), WHITE, 1)
    return out


# ----------------------------------- main ------------------------------------
def parse_roi(text):
    try:
        v = tuple(float(x) for x in text.split(","))
        if len(v) != 4 or not (0 <= v[0] < v[2] <= 1 and 0 <= v[1] < v[3] <= 1):
            raise ValueError
        return v
    except ValueError:
        raise argparse.ArgumentTypeError("--roi needs 4 fractions x0,y0,x1,y1 between 0 and 1, e.g. 0.10,0.50,0.90,0.95")


def parse_args(argv=None):
    ap = argparse.ArgumentParser(description="Railway safety: LiDAR + ultrasonic + camera fusion with 16x2 LCD")
    ap.add_argument("--headless", action="store_true", help="no preview window (use over SSH)")
    ap.add_argument("--roi", type=parse_roi, default=DEFAULT_ROI, metavar="x0,y0,x1,y1",
                    help="track corridor as frame fractions (default 0.10,0.50,0.90,0.95)")
    ap.add_argument("--min-area", type=int, default=DEFAULT_MIN_AREA, help="noise threshold in pixels (default 1500)")
    ap.add_argument("--center-area", type=int, default=None, help="area that counts as a LARGE obstacle in CENTER (default = --min-area)")
    ap.add_argument("--warmup", type=int, default=WARMUP_FRAMES, help="frames used to learn the empty background")
    ap.add_argument("--lcd-addr", type=lambda x: int(x, 0), default=LCD_ADDR_DEFAULT, help="I2C address, default 0x27")
    ap.add_argument("--no-lcd", action="store_true", help="run without the LCD")
    ap.add_argument("--log-interval", type=float, default=1.0, help="console status every N seconds when headless")
    return ap.parse_args(argv)


def main(argv=None):
    args = parse_args(argv)
    gui = not args.headless
    if gui and not HAS_DISPLAY:
        print("[Info] no display found - running headless")
        gui = False

    stop, reset_bg = threading.Event(), threading.Event()
    try:                                                        # Ctrl+C / kill = clean exit, USR1 = relearn background
        signal.signal(signal.SIGTERM, lambda *_: stop.set())
        if hasattr(signal, "SIGUSR1"):
            signal.signal(signal.SIGUSR1, lambda *_: reset_bg.set())
    except ValueError:
        pass

    hub, lcd_text = SensorHub(), LCDText()
    camera = CameraSource()
    vision = TrackVision(args.roi, args.min_area, args.center_area if args.center_area is not None else args.min_area, args.warmup)
    workers, lcd_thread, window = [], None, "Railway Safety Fusion"
    show_mask, fps, t_prev, last_log, last_label = False, 0.0, time.time(), 0.0, None

    try:
        camera.start()
        workers = [TFLunaReader(hub, stop), UltrasonicReader(hub, stop)]
        for w in workers:
            w.start()
        if not args.no_lcd:
            lcd_thread = LCDDisplay(lcd_text, args.lcd_addr, stop)
            lcd_thread.start()
            workers.append(lcd_thread)
        if gui:
            try:
                cv2.namedWindow(window, cv2.WINDOW_AUTOSIZE)
            except cv2.error as e:
                print("[Info] cannot open a window (%s) - running headless" % e)
                gui = False
        print("[Railway] camera: %s | mode: %s | ROI %s | min-area %d | press %s to quit" % (
            camera.kind, "window" if gui else "headless", args.roi, args.min_area, "q" if gui else "Ctrl+C"))

        while not stop.is_set():
            frame = camera.read()
            if frame is None:
                time.sleep(0.02)
                continue
            if reset_bg.is_set():
                reset_bg.clear()
                vision.reset()
                print("[Railway] background relearning...")

            vision.process(frame)
            snap = hub.snapshot()
            decision = fuse(snap, vision.active, vision.learning)
            lcd_text.set(lcd_line1(snap["lidar_cm"], snap["ultra_cm"]), decision.lcd)

            now = time.time()
            fps = 0.9 * fps + 0.1 / max(now - t_prev, 1e-3)
            t_prev = now

            if gui:
                cv2.imshow(window, draw_overlay(frame, vision, decision, snap, fps, show_mask))
                key = cv2.waitKey(1) & 0xFF
                if key in (ord("q"), 27):
                    break
                if key == ord("r"):
                    reset_bg.set()
                if key == ord("m"):
                    show_mask = not show_mask
                try:
                    if cv2.getWindowProperty(window, cv2.WND_PROP_VISIBLE) < 1:
                        break                                   # window closed with the X button
                except cv2.error:
                    break
            if decision.label != last_label or (not gui and now - last_log >= args.log_interval):
                last_label, last_log = decision.label, now
                print("[%s] %-18s | L:%s U:%s | cam L:%d C:%d R:%d | LCD '%s' | %.0f fps%s" % (
                    time.strftime("%H:%M:%S"), decision.label,
                    "---" if snap["lidar_cm"] is None else "%.0f" % snap["lidar_cm"],
                    "---" if snap["ultra_cm"] is None else "%.0f" % snap["ultra_cm"],
                    vision.active["LEFT"], vision.active["CENTER"], vision.active["RIGHT"],
                    fit16(decision.lcd), fps, (" | " + decision.reason) if decision.reason else ""))
    except KeyboardInterrupt:
        print("\n[Railway] Ctrl+C - shutting down")
    finally:
        stop.set()
        for w in workers:
            w.join(timeout=3.0)                                 # LCD thread clears the display here
        camera.stop()
        if GPIO is not None:
            try:
                GPIO.cleanup()
            except Exception:
                pass
        try:
            cv2.destroyAllWindows()
        except Exception:
            pass
        print("[Railway] stopped cleanly")
    return 0


if __name__ == "__main__":
    sys.exit(main())
