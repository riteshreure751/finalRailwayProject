OBS = {"state": "clear", "label": None, "distance": None, "nearest": None, "t0": 0.0, "snap": None, "snap_id": 0,
       "source": None, "conf": 0.0, "cam_found": False, "cam_label": None, "cam_conf": 0.0}


def annotate(fr, text, box=None, color=(60, 60, 255)):
    img = cv2.resize(fr, (480, int(480 * fr.shape[0] / fr.shape[1])))
    ih, iw = img.shape[:2]
    if box:
        cv2.rectangle(img, (int(box[0] * iw), int(box[1] * ih)), (int(box[2] * iw), int(box[3] * ih)), color, 2)
    if text:
        cv2.putText(img, text[:36], (10, 28), cv2.FONT_HERSHEY_SIMPLEX, 0.7, color, 2)
    return img


def set_snapshot(fr, text, box=None):
    if fr is None:
        return
    img = annotate(fr, text, box)
    ok, enc = cv2.imencode(".jpg", img, [cv2.IMWRITE_JPEG_QUALITY, 85])
    OBS["snap"], OBS["snap_id"] = enc.tobytes(), OBS["snap_id"] + 1
    try:
        name = datetime.datetime.now().strftime("obstacle_%Y%m%d_%H%M%S.jpg")
        cv2.imwrite(os.path.join(ROOT, "detections", name), fr)
    except Exception:
        pass


def identify(dist):
    """Runs AFTER the train has stopped: the camera looks at the obstacle and names it."""
    votes, lastfr = {}, None
    for _ in range(IDENT_FRAMES):
        fr = camera.get_frame()
        if fr is None:
            time.sleep(0.2)
            continue
        lastfr = fr
        try:
            r = detector.detect(fr)
        except Exception as e:
            print("[Identify] error: %s" % e)
            continue
        if r["found"]:
            v = votes.setdefault(r["label"], {"n": 0, "conf": 0.0, "src": r["source"], "box": r["box"]})
            v["n"] += 1
            if r["conf"] >= v["conf"]:
                v.update(conf=r["conf"], src=r["source"], box=r["box"])
        time.sleep(0.1)
    dtxt = "%.1f cm" % dist if dist is not None else ""
    if votes:
        label = max(votes, key=lambda k: (votes[k]["n"], votes[k]["conf"]))
        v = votes[label]
        OBS.update(label=label, conf=v["conf"])
        set_snapshot(lastfr, "%s %s" % (label, dtxt), v["box"])
    elif OBS.get("cam_label"):
        OBS.update(label=OBS["cam_label"], conf=OBS.get("cam_conf", 0.0))
        set_snapshot(lastfr, "%s %s" % (OBS["cam_label"], dtxt))
    else:
        OBS.update(label=None, conf=0.0)
        set_snapshot(lastfr, "Unknown object %s" % dtxt)
    OBS["state"] = "stopped"


def monitor():
    """Combined obstacle detection: LiDAR + Ultrasonic + Camera -> slow down -> stop -> name object."""
    hits, clear_t, lost_t = 0, None, None
    last_cam_t, cam_hit, cam_det = 0.0, False, {"found": False, "label": None, "conf": 0.0, "source": None, "box": None}
    ush = collections.deque()                       # (time, cm) ultrasonic history for sudden-change detection
    while True:
        time.sleep(0.05)
        now = time.time()
        lv = sval(LD)
        uv = sval(US) if USE_ULTRASONIC else None
        vals = [v for v in (lv, uv) if v is not None]
        near = min(vals) if vals else None
        OBS["nearest"] = near

        if now - last_cam_t >= CAM_POLL_SEC:
            last_cam_t = now
            fr = camera.get_frame()
            if fr is not None and detector.ready():
                try:
                    cam_det = detector.detect(fr)
                except Exception:
                    cam_det = {"found": False, "label": None, "conf": 0.0, "source": None, "box": None}
            else:
                cam_det = {"found": False, "label": None, "conf": 0.0, "source": None, "box": None}
            cam_hit = bool(CAM_DETECT_ACTIVE and cam_det.get("found"))
            OBS["cam_found"] = cam_hit
            OBS["cam_label"] = cam_det.get("label") if cam_hit else None
            OBS["cam_conf"] = cam_det.get("conf", 0.0) if cam_hit else 0.0

        drop = False
        if uv is not None:
            ush.append((now, uv))
            while ush and now - ush[0][0] > US_DROP_WINDOW:
                ush.popleft()
            drop = uv <= US_DROP_MAX_CM and (max(c for _, c in ush) - uv) >= US_DROP_CM
        else:
            ush.clear()
        st = OBS["state"]

        sensor_hit = (near is not None and near <= SLOW_CM) or drop
        any_hit = sensor_hit or cam_hit

        if st == "clear":
            if STOP_ON_SENSOR_LOSS and train.running and near is None and not cam_hit:      # safety: both distance sensors blind
                lost_t = lost_t or now
                if now - lost_t > SENSOR_LOSS_SECONDS:
                    train.stop("No sensor data - stopped for safety", braked=True)
                    lost_t = None
            else:
                lost_t = None
            hits = hits + 1 if any_hit else 0
            if hits >= 2:
                src = []
                if lv is not None and lv <= SLOW_CM:
                    src.append("LiDAR")
                if uv is not None and uv <= SLOW_CM:
                    src.append("Ultrasonic")
                if drop and not any(x.startswith("Ultrasonic") for x in src):
                    src.append("Ultrasonic (sudden change)")
                if cam_hit:
                    src.append("Camera (%s)" % (cam_det.get("label") or "object"))
                src_txt = " + ".join(src) if src else "Sensors"
                d_txt = ("%.1f cm" % near) if near is not None else "camera view"
                OBS.update(state="slowing", t0=now,
                           label=cam_det.get("label") if cam_hit else None,
                           conf=cam_det.get("conf", 0.0) if cam_hit else 0.0,
                           distance=near, source=src_txt)
                train.stop("Obstacle at %s (%s) - slowing down" % (d_txt, src_txt),
                           braked=True, smooth=True)
                clear_t, hits = None, 0

        elif st == "slowing":
            if near is not None:
                OBS["distance"] = near
            if train.running:
                if near is not None and near <= FINAL_STOP_CM:
                    train.stop("Obstacle too close - emergency stop", braked=True)      # last resort: cut power now
                elif near is not None:       # the closer the obstacle, the lower the speed limit
                    train.limit = int(max(0, min(SPEED_MAX, SPEED_MAX * (near - FINAL_STOP_CM) / (SLOW_CM - FINAL_STOP_CM))))
                else:
                    train.limit = min(train.limit if train.limit is not None else START_PWM, START_PWM)
            else:           # train has come to rest -> now name the object
                OBS["state"] = "identifying"
                threading.Thread(target=identify, args=(OBS["distance"],), daemon=True).start()

        else:               # identifying / stopped
            if near is not None:
                OBS["distance"] = near
            sensors_clear = (near is None or near > SLOW_CM + CLEAR_MARGIN_CM) and not (near is None and STOP_ON_SENSOR_LOSS)
            camera_clear = not cam_hit
            if sensors_clear and camera_clear and (near is not None or not USE_ULTRASONIC):
                if clear_t is None:
                    clear_t = now
                elif now - clear_t > 1.0 and OBS["state"] == "stopped":
                    OBS.update(state="clear", label=None, source=None, conf=0.0)
                    hits = 0
            else:
                clear_t = None


