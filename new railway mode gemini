class Train:
    def __init__(self):
        self.running, self.stopping, self.braked, self.reason = False, False, False, ""
        self.target, self.cur, self.t_start, self.limit = DEFAULT_SPEED, 0, 0.0, None
        self.fwd, self.low, self.pwm = [], [], None
        if GPIO_OK and ON_PI:
            try:
                self.fwd = [DigitalOutputDevice(p) for p in MOTOR_FWD_PINS]
                self.low = [DigitalOutputDevice(p) for p in MOTOR_LOW_PINS]
                self.pwm = PWMOutputDevice(MOTOR_PWM_PIN, frequency=1000)
            except Exception as e:
                print("[Motor] cannot start: %s (motor simulated)" % e)
        threading.Thread(target=self.loop, daemon=True).start()

    def _apply(self, v):
        if not self.pwm:
            return
        for d in self.low:
            d.off()
        if v <= 0:
            for d in self.fwd:
                d.off()
            self.pwm.value = 0
        else:
            for d in self.fwd:
                d.on()
            self.pwm.value = min(1.0, v / float(SPEED_MAX))

    def start(self):
        if OBS["state"] != "clear":
            return False, "Obstacle ahead - clear the track first"
        near = OBS["nearest"]
        if near is not None and near <= SLOW_CM:
            return False, "Obstacle within %g cm - clear the track first" % SLOW_CM
        if OBS.get("cam_found") and CAM_DETECT_ACTIVE:
            return False, "Camera sees obstacle (%s) - clear the track first" % (OBS.get("cam_label") or "object")
        if STOP_ON_SENSOR_LOSS and near is None:
            return False, "No valid sensor reading - check LiDAR / ultrasonic wiring"
        self.braked, self.reason, self.stopping, self.limit = False, "", False, None
        self.running, self.t_start = True, time.time()
        self.cur = min(START_PWM, self.target)
        return True, "started"

    def stop(self, reason="Stopped", braked=False, smooth=False):
        self.braked, self.reason = braked, reason
        if smooth and self.running and self.cur > 0:
            self.stopping = True                    # loop() lowers the speed gradually, then stops
        else:                                       # immediate stop
            self.running, self.stopping, self.cur, self.limit = False, False, 0, None
            self._apply(0)

    def ramping(self):
        return self.running and not self.stopping and (time.time() - self.t_start < RAMP_SECONDS or self.cur != self.target)

    def loop(self):
        down = max(1, int(DECEL_PER_SEC * 0.05))
        while True:
            if self.running:
                if self.stopping:
                    want = 0
                else:
                    frac = min(1.0, (time.time() - self.t_start) / RAMP_SECONDS)
                    want = self.target if self.target <= START_PWM else START_PWM + (self.target - START_PWM) * frac
                lim = self.limit
                if lim is not None:
                    want = min(want, lim)
                self.cur = int(round(self.cur + max(-down, min(6, want - self.cur))))
                if self.stopping and self.cur <= 0:
                    self.running, self.stopping, self.cur, self.limit = False, False, 0, None
                    self.reason = self.reason.replace("slowing down", "stopped")
                    self._apply(0)
                else:
                    self._apply(self.cur)
            time.sleep(0.05)


