class Camera:
    def __init__(self):
        self.lock, self.jpg, self.frame, self.id, self.kind = threading.Lock(), None, None, 0, "none"
        threading.Thread(target=self.run, daemon=True).start()

    def run(self):
        grab, cam = None, None
        if Picamera2:
            try:
                cam = Picamera2()
                cam.configure(cam.create_video_configuration(main={"size": (FRAME_W, FRAME_H), "format": "RGB888"}))
                cam.start()
                grab, self.kind = cam.capture_array, "Pi Camera"
            except Exception as e:
                print("[Camera] picamera2 failed: %s" % e)
        if grab is None:
            try:
                cap = cv2.VideoCapture(0)
                if cap.isOpened():
                    grab, self.kind = (lambda: cap.read()[1]), "USB/OpenCV"
            except Exception:
                pass
        while True:
            try:
                if grab:
                    fr = grab()
                else:
                    fr = np.zeros((FRAME_H, FRAME_W, 3), np.uint8) + 25
                    cv2.putText(fr, "NO CAMERA FOUND", (190, FRAME_H // 2), cv2.FONT_HERSHEY_SIMPLEX, 1.4, (80, 80, 255), 3)
                    time.sleep(0.1)
                if fr is None:
                    time.sleep(0.05)
                    continue
                if fr.ndim == 3 and fr.shape[2] == 4:
                    fr = fr[:, :, :3]
                ok, enc = cv2.imencode(".jpg", fr, [cv2.IMWRITE_JPEG_QUALITY, 70])
                with self.lock:
                    self.frame, self.jpg, self.id = fr, enc.tobytes(), self.id + 1
            except Exception as e:
                print("[Camera] error: %s" % e)
                time.sleep(0.5)

    def get_jpg(self):
        with self.lock:
            return self.jpg, self.id

    def get_frame(self):
        with self.lock:
            return None if self.frame is None else self.frame.copy()


